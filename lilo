#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  SOURCE="$(readlink -f "$SOURCE")"
fi
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

if [ -x "$SCRIPT_DIR/artifact" ] && [ ! -d "$SCRIPT_DIR/artifact" ]; then
  exec "$SCRIPT_DIR/artifact" menu "$@"
fi
exec "$SCRIPT_DIR/run_artifact.sh" menu "$@"
